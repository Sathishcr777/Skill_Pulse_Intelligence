# ==========================================
# SkillPulse Intelligence - Environment Config
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skillpulse
POSTGRES_PORT=5432

# Backend API Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/skillpulse
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# ==========================================
# Production values (set these in the hosting platform's
# environment-variable settings, never in a committed .env file)
# ==========================================
# Render (backend) — DATABASE_URL: the connection string Neon gives you,
# with +psycopg added after postgresql, e.g.:
#   postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require
# Render (backend) — BACKEND_CORS_ORIGINS: a JSON array literal, exact origin(s),
# no trailing slash:
#   ["https://your-app.vercel.app"]
# Vercel (frontend) — VITE_API_URL: your Render service's public URL:
#   https://skillpulse-backend.onrender.com
